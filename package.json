{
  "name": "radiodesk",
  "version": "0.3.0",
  "private": true,
  "description": "A single-file open source amateur radio station, wideband SDR receiver, FT8/FT4 modem and RF workbench.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node build/dev.mjs",
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run verify",
    "build:ftx": "node build/build-ftx.mjs",
    "test:bridge": "python3 -B bridge/test_rtl_tcp_ws.py && python3 -B bridge/test_hamlib_ws.py",
    "verify": "node build/verify.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
